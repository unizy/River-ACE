[Unit]
Description=River Ace online multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=riverace
Group=riverace
WorkingDirectory=/opt/river-ace
Environment=NODE_ENV=production
Environment=PORT=80
Environment=RIVER_ACE_DATA=/var/lib/river-ace/store.json
ExecStart=/opt/node-v24.19.0/bin/node /opt/river-ace/node_modules/tsx/dist/cli.mjs /opt/river-ace/server/index.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/river-ace
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
