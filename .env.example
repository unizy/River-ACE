# 游戏服务
PORT=8787
RIVER_ACE_DATA=server/data/store.json

# LiveKit 公网 WebSocket 地址。生产环境必须使用 wss://。
LIVEKIT_URL=wss://voice.unizy.online
# 可选：游戏服务器访问 LiveKit API 的内网/HTTP 地址。
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=replace-with-a-random-key
LIVEKIT_API_SECRET=replace-with-a-long-random-secret
